# Application
APP_ENV=local
APP_NAME=omiryn
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=debug

# Database
# Local default can be SQLite: sqlite:///./data/omiryn.db
# Local Postgres with Docker Compose:
# POSTGRES_DB=omiryn
# POSTGRES_USER=omiryn
# POSTGRES_PASSWORD=omiryn
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://omiryn:omiryn@localhost:5432/omiryn
# Production should use hosted Postgres.
DATABASE_URL=sqlite:///./data/omiryn.db

# Profile photo uploads. Local disk is used unless PROFILE_PHOTO_GCS_BUCKET is set.
PROFILE_PHOTO_MAX_MB=10
PROFILE_PHOTO_GCS_BUCKET=omiryn_bucket
PROFILE_PHOTO_GCS_PREFIX=profile_photos
PROFILE_PHOTO_GCS_PUBLIC_READ=true

# Per-user quota defaults. Set a monthly limit to 0 to disable that limit.
# Burst protection is automatic: each action is capped at min(monthly limit, 10) per minute.
USER_LIMIT_MONTH_DAYS=30
USER_CHAT_MONTHLY_LIMIT=300
USER_CONTEXT_IMPORT_MONTHLY_LIMIT=10
USER_WHATSAPP_IMPORT_MONTHLY_LIMIT=3

# Redis / queue
REDIS_URL=redis://localhost:6379/0

# AI providers
# Use "mock", "openai", "groq", "deepinfra", "fireworks", or "ollama".
AGENT_PROVIDER=mock
# One pipeline version and rollout stage control the coordinated agent behavior.
# v1/off: legacy; v2/off: structured inline; v2/shadow: safe observation;
# v2/live: background memory writes (conversation threads remain shadow-only).
AGENT_PIPELINE_VERSION=v2
AGENT_ROLLOUT=shadow
# Silence (hours) after which the next user message counts as a new session.
AGENT_SESSION_GAP_HOURS=6
# Used until the user's browser reports its own timezone.
AGENT_DEFAULT_TIMEZONE=Asia/Kolkata
# Recent messages sent word for word; older ones come from the background conversation summary.
AGENT_RECENT_MESSAGE_LIMIT=24
# Estimated token cap for that chat history; long old messages are shortened first.
AGENT_HISTORY_TOKEN_BUDGET=4000
# Whole system prompt cap in characters; below ~18000 fixed sections get cut silently.
AGENT_PROMPT_TOTAL_CHAR_BUDGET=24000
# Character cards (human backstories) are off until an AI-true persona is designed.
AGENT_PERSONA_CARDS_ENABLED=false
# Bubbles per reply (normal chat uses 1-3 by prompt; stories up to this cap) and words per bubble.
AGENT_MAX_REPLY_PARTS=7
AGENT_REPLY_PART_WORD_LIMIT=35
# One rewrite when a reply is stock filler or repeats itself (extra model call only on a hit).
AGENT_FRESHNESS_CHECK=true
# Retries for transient provider failures (connection errors, 429, 5xx); slow replies are not retried.
AGENT_PROVIDER_RETRIES=2
# The reply waits on the memory lookup embedding; on timeout it falls back to keyword recall.
MEMORY_EMBEDDING_QUERY_TIMEOUT_SECONDS=8
# Durable background jobs (agent_jobs table), polled inside the API process.
AGENT_JOBS_ENABLED=true
AGENT_JOB_POLL_SECONDS=10
# Quiet time before sub-threshold messages are sent to background memory.
MEMORY_IDLE_FLUSH_SECONDS=120
MEMORY_BACKGROUND_V2_THRESHOLD=7
MEMORY_BACKGROUND_V2_CONTEXT_OVERLAP=12
MEMORY_BACKGROUND_V2_TIMEOUT_SECONDS=120
MEMORY_BACKGROUND_V2_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AVAILABLE_MODELS=gpt-4.1-mini,gpt-5.6-luna,gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
# Set current prices for your chosen model if estimated costs are needed in reports.
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_AVAILABLE_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
GROQ_INPUT_COST_PER_1M=0
GROQ_OUTPUT_COST_PER_1M=0
DEEPINFRA_API_KEY=
# DEEPINFRA_TOKEN is also accepted if you prefer DeepInfra's naming.
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPINFRA_AVAILABLE_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,meta-llama/Llama-3.1-70B-Instruct-Turbo,deepseek-ai/DeepSeek-V3
DEEPINFRA_INPUT_COST_PER_1M=0.10
DEEPINFRA_OUTPUT_COST_PER_1M=0.32
# Behavioral-evaluation judges may be slower than normal companion replies.
AGENT_EVAL_JUDGE_TIMEOUT_SECONDS=120
AGENT_EVAL_JUDGE_MAX_ATTEMPTS=3
AGENT_EVAL_JUDGE_RETRY_DELAY_SECONDS=1
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_AVAILABLE_MODELS=accounts/fireworks/models/gpt-oss-120b,accounts/fireworks/models/llama-v3p3-70b-instruct,accounts/fireworks/models/deepseek-v3p1
FIREWORKS_INPUT_COST_PER_1M=0.15
FIREWORKS_OUTPUT_COST_PER_1M=0.60
USD_TO_INR=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_AVAILABLE_MODELS=llama3.1

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Base64 urlsafe 32-byte key for app-level encrypted storage.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=

# Auth
# Current adapter: supabase. Future adapters can use the same app-level identity contract.
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# If unset, auth is required by default when an auth provider is configured.
AUTH_REQUIRED=true
# Set true only for admin/dev views. Shows raw internal profile data points in the UI.
PROFILE_DEBUG_DATA_ENABLED=false

# Messaging
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
