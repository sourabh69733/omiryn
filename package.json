{
  "name": "omiryn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clear-deps": "rm -rf node_modules/.vite",
    "start": "npm run clear-deps && bash scripts/start.sh",
    "start:prod": "START_MODE=production bash scripts/start.sh",
    "landing:dev": "vite --config apps/landing/vite.config.js",
    "landing:build": "vite build --config apps/landing/vite.config.js",
    "landing:preview": "vite preview --config apps/landing/vite.config.js",
    "landing:deploy": "npx wrangler deploy --config wrangler.jsonc",
    "web:dev": "vite --config apps/web/vite.config.js",
    "web:build": "vite build --config apps/web/vite.config.js",
    "web:preview": "vite preview --config apps/web/vite.config.js",
    "web:deploy": "npx wrangler deploy --config apps/web/wrangler.jsonc",
    "web:check": "tsc -p apps/web/tsconfig.json --noEmit",
    "feedback:dev": "vite --config apps/feedback/vite.config.js",
    "feedback:build": "vite build --config apps/feedback/vite.config.js",
    "feedback:preview": "vite preview --config apps/feedback/vite.config.js",
    "feedback:check": "tsc -p apps/feedback/tsconfig.json --noEmit",
    "feedback:worker:check": "node --check apps/feedback/worker/index.js",
    "feedback:deploy": "npx wrangler deploy --config apps/feedback/wrangler.jsonc",
    "build": "npm run landing:build && npm run web:build && npm run feedback:build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@vitejs/plugin-react": "^4.3.4",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
