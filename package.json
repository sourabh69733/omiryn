{
  "name": "omiryn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clear-deps": "rm -rf node_modules/.vite",
    "start": "npm run clear-deps && bash scripts/start.sh",
    "start:prod": "START_MODE=production bash scripts/start.sh",
    "landing:dev": "vite --config apps/landing/vite.config.js",
    "landing:build": "vite build --config apps/landing/vite.config.js",
    "landing:preview": "vite preview --config apps/landing/vite.config.js",
    "landing:deploy": "npx wrangler deploy --config wrangler.jsonc",
    "web:dev": "vite --config apps/web/vite.config.js",
    "web:build": "vite build --config apps/web/vite.config.js",
    "web:preview": "vite preview --config apps/web/vite.config.js",
    "web:deploy": "npx wrangler deploy --config apps/web/wrangler.jsonc",
    "web:check": "tsc -p apps/web/tsconfig.json --noEmit",
    "web:test": "tsx --test apps/web/src/ui/app/*.test.ts apps/web/src/ui/app/*.test.tsx",
    "admin:dev": "vite --config apps/admin/vite.config.js",
    "admin:test": "node --test apps/admin/src/*.test.js",
    "admin:check": "node --check apps/admin/src/api.js && node --check apps/admin/src/auth.js && node --check apps/admin/src/main.js",
    "admin:build": "vite build --config apps/admin/vite.config.js",
    "admin:preview": "vite preview --config apps/admin/vite.config.js",
    "admin:deploy": "npx wrangler deploy --config apps/admin/wrangler.jsonc",
    "feedback:dev": "vite --config apps/feedback/vite.config.js",
    "feedback:build": "vite build --config apps/feedback/vite.config.js",
    "feedback:preview": "vite preview --config apps/feedback/vite.config.js",
    "feedback:check": "tsc -p apps/feedback/tsconfig.json --noEmit",
    "feedback:worker:check": "node --check apps/feedback/worker/index.js",
    "feedback:worker:test": "node --test apps/feedback/worker/index.test.js",
    "feedback:db:migrate": "npx wrangler d1 migrations apply omiryn-feedback --remote --config apps/feedback/wrangler.jsonc",
    "feedback:deploy": "npm run feedback:db:migrate && npx wrangler deploy --config apps/feedback/wrangler.jsonc",
    "build": "npm run landing:build && npm run web:build && npm run feedback:build && npm run admin:build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@vitejs/plugin-react": "^4.3.4",
    "emoji-picker-react": "^4.19.1",
    "emojibase-data": "^17.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.12"
  }
}
